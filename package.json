{
  "name": "atividade-testes-mutacao",
  "version": "1.0.0",
  "description": "Testes de mutação com Stryker Mutator sobre os testes unitários (Jest) da Prova 01",
  "main": "index.js",
  "author": "Gabriel Matiola Pagnan",
  "license": "ISC",
  "dependencies": {
    "jest": "^30.4.2",
    "mkdirp": "^3.0.1",
    "rimraf": "^6.1.3"
  },
  "scripts": {
    "clean": "rimraf ./coverage ./reports && mkdirp ./coverage",
    "test": "jest",
    "coverage": "jest --coverage",
    "mutation": "stryker run"
  },
  "jest": {
    "collectCoverageFrom": [
      "src/**/*.js"
    ],
    "coverageReporters": [
      "lcov",
      "text"
    ]
  },
  "devDependencies": {
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/jest-runner": "^10.1.1"
  }
}
